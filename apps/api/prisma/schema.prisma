generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

enum BillStatus {
  ACTIVE
  DONE

  @@map("bill_status")
}

enum PaymentType {
  QRIS
  BANK
  EWALLET

  @@map("payment_type")
}

enum ReceiptStatus {
  PROCESSED
  FAILED

  @@map("receipt_status")
}

model Bill {
  id             String     @id @default(uuid()) @db.Uuid
  title          String     @db.VarChar(120)
  billDate       DateTime   @map("bill_date") @db.Date
  taxPercent     Decimal    @default(0) @map("tax_percent") @db.Decimal(5, 2)
  servicePercent Decimal    @default(0) @map("service_percent") @db.Decimal(5, 2)
  status         BillStatus @default(ACTIVE)
  shareCode      String     @unique @map("share_code") @db.VarChar(12)
  ownerToken     String     @map("owner_token") @db.VarChar(64)
  userId         String?    @map("user_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  participants   Participant[]
  items          Item[]
  paymentMethods PaymentMethod[]
  receipts       Receipt[]
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([userId])
  @@map("bills")
}

model Participant {
  id        String    @id @default(uuid()) @db.Uuid
  billId    String    @map("bill_id") @db.Uuid
  name      String    @db.VarChar(60)
  isOwner   Boolean   @default(false) @map("is_owner")
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
  openedAt  DateTime? @map("opened_at") @db.Timestamptz(6)
  sortOrder Int       @default(0) @map("sort_order")

  bill        Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  assignments ItemAssignment[]

  @@unique([billId, name])
  @@index([billId])
  @@map("participants")
}

model Item {
  id        String @id @default(uuid()) @db.Uuid
  billId    String @map("bill_id") @db.Uuid
  name      String @db.VarChar(120)
  price     Int
  qty       Int    @default(1)
  sortOrder Int    @default(0) @map("sort_order")

  bill        Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  assignments ItemAssignment[]

  @@index([billId])
  @@map("items")
}

model ItemAssignment {
  itemId        String @map("item_id") @db.Uuid
  participantId String @map("participant_id") @db.Uuid

  item        Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([itemId, participantId])
  @@index([participantId])
  @@map("item_assignments")
}

model PaymentMethod {
  id            String      @id @default(uuid()) @db.Uuid
  billId        String      @map("bill_id") @db.Uuid
  type          PaymentType
  label         String      @db.VarChar(60)
  accountNumber String?     @map("account_number") @db.VarChar(40)
  accountName   String?     @map("account_name") @db.VarChar(80)
  qrisPayload   String?     @map("qris_payload") @db.VarChar(600)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("payment_methods")
}

model Receipt {
  id        String        @id @default(uuid()) @db.Uuid
  billId    String        @map("bill_id") @db.Uuid
  filePath  String        @map("file_path") @db.VarChar(255)
  mimeType  String        @map("mime_type") @db.VarChar(60)
  rawText   String?       @map("raw_text")
  status    ReceiptStatus @default(PROCESSED)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("receipts")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(80)
  email        String   @unique @db.VarChar(160)
  passwordHash String?  @map("password_hash") @db.VarChar(100)
  googleId     String?  @unique @map("google_id") @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  settings       UserSettings?
  bills          Bill[]
  notifications  Notification[]
  passwordResets PasswordReset[]

  @@map("users")
}

model UserSettings {
  userId         String  @id @map("user_id") @db.Uuid
  theme          String  @default("light") @db.VarChar(10) // light | dark | system
  notifyPaid     Boolean @default(true) @map("notify_paid")
  notifyReminder Boolean @default(true) @map("notify_reminder")
  reminderDays   Int     @default(3) @map("reminder_days")
  notifyEmail    Boolean @default(false) @map("notify_email")
  notifyOpened   Boolean @default(false) @map("notify_opened")
  notifyDone     Boolean @default(true) @map("notify_done")
  accent         String  @default("biru") @db.VarChar(12) // biru | merah | kuning | hijau | ungu | peach
  defaultPaymentMethods Json @default("[]") @map("default_payment_methods")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  billId    String?   @map("bill_id") @db.Uuid
  type      String    @db.VarChar(20) // BILL_CREATED | PAID | BILL_DONE | REMINDER | LINK_OPENED
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(255)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill Bill? @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
