DATABASE_URL="postgresql://splitbill:splitbill@localhost:5432/splitbill?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173
# tesseract = OCR sungguhan (default, tesseract.js) | mock = data contoh tetap (hanya untuk mencoba UI)
OCR_PROVIDER=tesseract
# tempat menyimpan data bahasa OCR yang diunduh sekali (supaya tidak diunduh ulang)
OCR_CACHE_DIR=./.tessdata
UPLOAD_DIR=./uploads

# --- Auth & email ---
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d
WEB_URL=http://localhost:5173
# console = link reset dicetak di log server (dev) | smtp = kirim email sungguhan
# Login Google (opsional): buat OAuth Client ID tipe Web di Google Cloud Console,
# isi "Authorized JavaScript origins" dengan URL web kamu. Kosongkan = tombol Google tidak muncul.
GOOGLE_CLIENT_ID=
MAIL_PROVIDER=console
MAIL_FROM="Tagihanku <no-reply@tagihanku.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
